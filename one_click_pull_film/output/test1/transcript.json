[
    {
        "start": 0.0,
        "end": 2.0,
        "text": "最近总是接到观众来信"
    },
    {
        "start": 2.0,
        "end": 5.0,
        "text": "问我们这伙人为什么总是泡在酒吧里"
    },
    {
        "start": 5.6,
        "end": 8.0,
        "text": "你以为我们只是在打发时间"
    },
    {
        "start": 8.0,
        "end": 9.0,
        "text": "你错了"
    },
    {
        "start": 9.0,
        "end": 15.0,
        "text": "在这里我们会经常讨论一些非常高深的社会话题"
    },
    {
        "start": 15.0,
        "end": 16.0,
        "text": "请问"
    },
    {
        "start": 16.0,
        "end": 19.0,
        "text": "最近我的电脑显示器一直不停地抖动"
    },
    {
        "start": 19.0,
        "end": 21.0,
        "text": "有什么办法没有"
    },
    {
        "start": 21.0,
        "end": 22.0,
        "text": "你也不停抖"
    },
    {
        "start": 22.0,
        "end": 26.0,
        "text": "当你的频率和政府与显示器画面一致的时候"
    },
    {
        "start": 26.0,
        "end": 28.0,
        "text": "你就感觉不出来了"
    },
    {
        "start": 29.0,
        "end": 30.0,
        "text": "好注意"
    },
    {
        "start": 31.0,
        "end": 32.0,
        "text": "提问"
    },
    {
        "start": 32.0,
        "end": 34.0,
        "text": "马亚人的预言到底靠不靠谱"
    },
    {
        "start": 34.0,
        "end": 36.0,
        "text": "2012真的是世界谋日吗"
    },
    {
        "start": 36.0,
        "end": 38.0,
        "text": "听说美国有钱人都去买传票了"
    },
    {
        "start": 38.0,
        "end": 40.0,
        "text": "否则怎么会进入危机呢"
    },
    {
        "start": 40.0,
        "end": 41.0,
        "text": "传票"
    },
    {
        "start": 41.0,
        "end": 42.0,
        "text": "那个买传票的"
    },
    {
        "start": 42.0,
        "end": 43.0,
        "text": "逃跑人现在就有"
    },
    {
        "start": 43.0,
        "end": 46.0,
        "text": "我看过11幼园支付宝支付"
    },
    {
        "start": 46.0,
        "end": 48.0,
        "text": "可不可以获到付款"
    },
    {
        "start": 48.0,
        "end": 50.0,
        "text": "先生我传在手"
    },
    {
        "start": 50.0,
        "end": 51.0,
        "text": "提问"
    },
    {
        "start": 51.0,
        "end": 53.0,
        "text": "你们说刘官正逃远结议的时候"
    },
    {
        "start": 53.0,
        "end": 54.0,
        "text": "共的是谁啊"
    },
    {
        "start": 55.0,
        "end": 56.0,
        "text": "黄天后土"
    },
    {
        "start": 56.0,
        "end": 57.0,
        "text": "严华二天"
    },
    {
        "start": 57.0,
        "end": 58.0,
        "text": "共的"
    },
    {
        "start": 58.0,
        "end": 59.0,
        "text": "但是逃的了"
    },
    {
        "start": 59.0,
        "end": 61.0,
        "text": "我看你没许到"
    },
    {
        "start": 61.0,
        "end": 63.0,
        "text": "他们出来混江湖"
    },
    {
        "start": 63.0,
        "end": 65.0,
        "text": "共的应该是"
    },
    {
        "start": 66.0,
        "end": 67.0,
        "text": "关二爷吧"
    },
    {
        "start": 73.0,
        "end": 74.0,
        "text": "提问"
    },
    {
        "start": 74.0,
        "end": 75.0,
        "text": "你们说什么"
    },
    {
        "start": 75.0,
        "end": 77.0,
        "text": "你怎么知道"
    },
    {
        "start": 77.0,
        "end": 78.0,
        "text": "你怎么知道"
    },
    {
        "start": 78.0,
        "end": 79.0,
        "text": "提问"
    },
    {
        "start": 79.0,
        "end": 81.0,
        "text": "你们说雨莫倒掉多久"
    },
    {
        "start": 81.0,
        "end": 83.0,
        "text": "才能从感情失败的印影中"
    },
    {
        "start": 83.0,
        "end": 84.0,
        "text": "真真站起来"
    },
    {
        "start": 85.0,
        "end": 86.0,
        "text": "嗯"
    },
    {
        "start": 86.0,
        "end": 87.0,
        "text": "这是我们半年来"
    },
    {
        "start": 87.0,
        "end": 88.0,
        "text": "讨论最有营养的一话题"
    },
    {
        "start": 88.0,
        "end": 89.0,
        "text": "现在回到我"
    },
    {
        "start": 89.0,
        "end": 90.0,
        "text": "多久"
    },
    {
        "start": 90.0,
        "end": 91.0,
        "text": "多久啊"
    },
    {
        "start": 91.0,
        "end": 93.0,
        "text": "什么叫多久啊"
    },
    {
        "start": 93.0,
        "end": 95.0,
        "text": "这没法预测"
    },
    {
        "start": 95.0,
        "end": 96.0,
        "text": "决定因素太多了"
    },
    {
        "start": 96.0,
        "end": 98.0,
        "text": "他能不能真的站起来"
    },
    {
        "start": 98.0,
        "end": 99.0,
        "text": "就主要看照顾"
    },
    {
        "start": 100.0,
        "end": 102.0,
        "text": "那如果是你能意见"
    },
    {
        "start": 102.0,
        "end": 104.0,
        "text": "什么叫站起来"
    },
    {
        "start": 104.0,
        "end": 105.0,
        "text": "为什么要站起来"
    },
    {
        "start": 105.0,
        "end": 107.0,
        "text": "如果我的感情失败的话"
    },
    {
        "start": 107.0,
        "end": 108.0,
        "text": "怕在地上的"
    },
    {
        "start": 108.0,
        "end": 109.0,
        "text": "一定是对方"
    },
    {
        "start": 110.0,
        "end": 111.0,
        "text": "四朝"
    },
    {
        "start": 111.0,
        "end": 112.0,
        "text": "你说呢"
    },
    {
        "start": 112.0,
        "end": 113.0,
        "text": "啊"
    },
    {
        "start": 113.0,
        "end": 114.0,
        "text": "什么叫失败"
    },
    {
        "start": 114.0,
        "end": 116.0,
        "text": "为什么会失败"
    },
    {
        "start": 116.0,
        "end": 117.0,
        "text": "日出东方"
    },
    {
        "start": 117.0,
        "end": 118.0,
        "text": "为我不败"
    },
    {
        "start": 118.0,
        "end": 119.0,
        "text": "说这个问题"
    },
    {
        "start": 119.0,
        "end": 121.0,
        "text": "实在不知道该怎么回答"
    },
    {
        "start": 121.0,
        "end": 123.0,
        "text": "你们还是我们张伟吧"
    },
    {
        "start": 123.0,
        "end": 124.0,
        "text": "他有经验"
    },
    {
        "start": 124.0,
        "end": 126.0,
        "text": "就并成良一马"
    },
    {
        "start": 130.0,
        "end": 132.0,
        "text": "你们非要讨论这个话题吗"
    },
    {
        "start": 134.0,
        "end": 135.0,
        "text": "你们聊不我先走了"
    },
    {
        "start": 137.0,
        "end": 139.0,
        "text": "好"
    },
    {
        "start": 149.0,
        "end": 150.0,
        "text": "你不玩"
    },
    {
        "start": 150.0,
        "end": 151.0,
        "text": "你在吃什么呀"
    },
    {
        "start": 151.0,
        "end": 152.0,
        "text": "好好干杯"
    },
    {
        "start": 152.0,
        "end": 153.0,
        "text": "对了"
    },
    {
        "start": 153.0,
        "end": 154.0,
        "text": "你提醒我了"
    },
    {
        "start": 154.0,
        "end": 155.0,
        "text": "没了"
    },
    {
        "start": 155.0,
        "end": 156.0,
        "text": "这就没点了"
    },
    {
        "start": 156.0,
        "end": 157.0,
        "text": "都带我把你来"
    },
    {
        "start": 159.0,
        "end": 160.0,
        "text": "等音"
    }
]